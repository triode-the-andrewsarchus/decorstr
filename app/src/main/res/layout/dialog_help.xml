<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_help"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Decorstr Field Guide"
                android:textColor="@color/accent_gold"
                android:textSize="18sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Multispectral &amp; Decorrelation Stretch Analysis"
                android:textColor="#AAAAAA"
                android:textSize="12sp"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/btnHelpClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:gravity="center"
            android:text="✕"
            android:textColor="@color/white"
            android:textSize="18sp"
            android:textStyle="bold"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:clickable="true"
            android:focusable="true" />
    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#333333"
        android:layout_marginBottom="12dp" />

    <!-- Scrollable Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Section 1: Enhancement Modes -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ANALYSIS &amp; ENHANCEMENT MODES"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <!-- LAB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="General"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="LAB"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Broad geological mapping, multi-mineral outcrops, landscape surveys, and general surface inspection.\n• How it works: Decorrelates chromaticity (a*, b*) in CIE L*a*b* space while preserving natural perceptual lightness (L*).\n• Application: Recommended starting mode. Retains realistic topography, lighting, and surface texture while accentuating subtle chromatic boundaries between rock units or material layers."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- CRGB -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reds"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="CRGB"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Iron oxides (hematite), gossans, rust/corrosion inspection, and reddish alteration halos.\n• How it works: Classic NASA JPL decorrelation stretch in linear RGB. Equalizes variance across color channels to remove high inter-band correlation.\n• Application: Excellent for detecting early oxidation, rust pitting on industrial structures, and distinguishing hematite-rich zones from neutral host rock (granite, basalt, limestone)."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YRD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Red / Iron"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YRD"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Hydrothermal alteration, ferruginous sandstone, weathered surfaces, and desert varnish.\n• How it works: Rotates into Y-space; doubles red-difference chroma (V = R - Y, 2.0x) while suppressing blue noise (0.5x).\n• Application: Isolates iron oxide stains and mineralization where host rock surfaces have ambient reddish or brownish background tones."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YRE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Faint Reds"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YRE"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Incipient corrosion, micro-oxidation, subtle hydrothermal veins, and faint chemical staining.\n• How it works: Applies an aggressive 4.0x boost to red-difference chromaticity (V) with heavy blue noise compression (0.35x).\n• Application: Maximum sensitivity for trace iron and reddish chemical residues that are nearly imperceptible to the naked eye."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YYE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Yellows"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YYE"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Limonite, goethite, sulfur deposits, jarosite, and yellow chemical leaching.\n• How it works: Inverts and amplifies yellow-blue chroma (Y - B = -U, 2.5x boost) while scaling red-green (0.8x).\n• Application: High contrast for secondary weathering minerals, acid-mine drainage residues, and yellow altered zones against tan/brown rocks."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YBL -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blues"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YBL"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Azurite, chrysocolla, vivianite, copper patina, weld heat tinting, and blue industrial fluid leaks (hydraulic fluid/tracers).\n• How it works: Amplifies positive blue-difference chroma (U = B - Y) by 3.0x while suppressing red/luminance noise (0.7x).\n• Application: High sensitivity for secondary copper mineralization, cobalt minerals, and thermal oxidation halos on stainless steels and titanium."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YGN -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Greens"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YGN"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Malachite, chlorite alteration, nickel blooms (annabergite), fuchsite, and engine coolant/fluorescent leaks.\n• How it works: Orthogonal Green-Magenta axis rotation in YUV space with 2.5x variance boost along the green vector.\n• Application: Pinpoints hydrothermal green alteration, secondary copper/nickel mineralization, and radiator/coolant seepage against tan/gray substrates."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YBK -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Blacks"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YBK"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Manganese dendrites/coatings, carbonaceous seams, magnetite/ilmenite, and soot/burn patterns.\n• How it works: Amplifies luminance contrast 2.2x while attenuating chromatic noise (0.5x).\n• Application: Enhances dark lithological fractures, fine structural cracks, carbon fiber defects, and dark mineral banding in shadowed or patinated surfaces."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YWE -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Whites"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YWE"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Calcite/carbonate veining, quartz veins, evaporites (gypsum/halite), efflorescence, and salt weathering.\n• How it works: Amplifies high-reflectance luminance 2.5x with moderate chroma (0.7x).\n• Application: Maps white crystalline veins, concrete mineral efflorescence, and salt encrustations against light or reflective matrices."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- YDT -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Yellow / Gen"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="YDT"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Mixed mineral assemblages, drill core logging, and general engineering inspection.\n• How it works: Standard Rec.601 YUV decorrelation stretch with equal 1:1:1 channel weighting.\n• Application: Balanced across all spectral bands. Great for drill core analysis, soil strata profiling, and identifying mixed alteration facies without hue bias."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- RGB0 -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Deep Reds"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RGB0"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Outcrops in deep shade, dark basaltic formations, and high-contrast structural features.\n• How it works: Zero-mean linear RGB decorrelation stretch; forces bias vector b = 0.\n• Application: Prevents dark shadows and deep rock fissures from washing out into mid-gray pastel haze, maintaining true black depth while enhancing surface spectral signatures."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- PCA -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="10dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Spectral"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="PCA"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: Lithological classification, distinguishing distinct mineral phases, and multi-component spectral analysis.\n• How it works: Direct Principal Component Analysis; maps 1st, 2nd, and 3rd orthogonal eigenvectors directly to R, G, B display channels.\n• Application: Uncorrelated false-color imagery where distinct spectral absorption features map to dramatically different primary colors, revealing hidden geologic boundaries."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- RAW -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="6dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Neutral"
                        android:textColor="@color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="RAW"
                        android:textColor="@color/accent_gold"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_help_badge"
                        android:paddingHorizontal="6dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Best for: True-to-life physical baseline and visual ground truth.\n• How it works: Calibrated RAW sensor stream with daylight neutral white balance and sRGB gamma curve, without decorrelation stretch.\n• Application: Ground truth reference to evaluate physical appearance and true illumination conditions before enhancement."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>

            <!-- Section 2: Field Controls -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FIELD &amp; ANALYSIS CONTROLS"
                android:textColor="@color/accent_gold"
                android:textSize="12sp"
                android:textStyle="bold"
                android:letterSpacing="0.08"
                android:layout_marginBottom="10dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_help_card"
                android:padding="12dp"
                android:layout_marginBottom="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="• Smoothing Slider: Temporal filter strength (0.01 = stable lock for stationary inspection/tripods; 1.0 = dynamic response for scanning outcrops).\n\n• Intensity Slider: Adjusts stretch standard deviation (0.05 to 0.40). Higher values produce bolder false colors; lower values yield subtle gradients.\n\n• LOCK MATRIX: Freezes the current whitening transformation matrix and bias. Frame a target outcrop or sample section, lock the matrix, and scan across geological formations without illumination or rock variation causing color drift.\n\n• CAPTURE: Saves a full 12.5MP debayered processed JPEG with the exact live preview colors, plus an archival 16-bit Adobe DNG RAW file in Pictures/Decorstr.\n\n• FIT / FILL: Toggles between full-sensor 4:3 uncropped framing (letterboxed) and fullscreen cropping.\n\n• CAM ▾: Selects from available RAW-capable cameras on your device with per-sensor calibrated white balance."
                    android:textColor="#CCCCCC"
                    android:textSize="12sp"
                    android:lineSpacingExtra="3dp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- Close Button -->
    <Button
        android:id="@+id/btnHelpOk"
        android:layout_width="match_parent"
